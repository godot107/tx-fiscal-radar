{
  "name": "pl_load_sql",
  "properties": {
    "description": "Gold Parquet \u2192 Azure SQL staging (truncate + insert), then dw.usp_load_all builds the star schema (SCD2 bills).",
    "folder": {
      "name": "serve"
    },
    "parameters": {
      "tables": {
        "type": "array",
        "defaultValue": [
          "bill",
          "bill_action",
          "bill_subject",
          "fiscal_note_latest",
          "fiscal_note_version",
          "fiscal_note_drift",
          "fiscal_note_agency",
          "fiscal_note_year",
          "agency_spend",
          "ai_agency_cost",
          "ai_mandate"
        ]
      }
    },
    "activities": [
      {
        "name": "for_each_table",
        "type": "ForEach",
        "typeProperties": {
          "items": {
            "value": "@pipeline().parameters.tables",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "table_exists",
              "type": "GetMetadata",
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 2,
                "retryIntervalInSeconds": 60
              },
              "typeProperties": {
                "dataset": {
                  "referenceName": "ds_lake_parquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "folder": {
                      "value": "@item()",
                      "type": "Expression"
                    }
                  }
                },
                "fieldList": [
                  "exists"
                ],
                "storeSettings": {
                  "type": "AzureBlobFSReadSettings"
                }
              }
            },
            {
              "name": "if_exists",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "table_exists",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@activity('table_exists').output.exists",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "copy_to_staging",
                    "type": "Copy",
                    "policy": {
                      "timeout": "0.02:00:00",
                      "retry": 2,
                      "retryIntervalInSeconds": 120
                    },
                    "inputs": [
                      {
                        "referenceName": "ds_lake_parquet",
                        "type": "DatasetReference",
                        "parameters": {
                          "folder": {
                            "value": "@item()",
                            "type": "Expression"
                          }
                        }
                      }
                    ],
                    "outputs": [
                      {
                        "referenceName": "ds_sql",
                        "type": "DatasetReference",
                        "parameters": {
                          "schema": "stg",
                          "table": {
                            "value": "@item()",
                            "type": "Expression"
                          }
                        }
                      }
                    ],
                    "typeProperties": {
                      "source": {
                        "type": "ParquetSource",
                        "storeSettings": {
                          "type": "AzureBlobFSReadSettings",
                          "recursive": true,
                          "wildcardFileName": "*.parquet"
                        }
                      },
                      "sink": {
                        "type": "AzureSqlSink",
                        "writeBehavior": "insert",
                        "sqlWriterUseTableLock": true,
                        "preCopyScript": {
                          "value": "@concat('TRUNCATE TABLE stg.', item())",
                          "type": "Expression"
                        },
                        "tableOption": "none"
                      },
                      "translator": {
                        "type": "TabularTranslator",
                        "typeConversion": true,
                        "typeConversionSettings": {
                          "allowDataTruncation": false,
                          "treatBooleanAsNumber": false
                        }
                      },
                      "enableStaging": false
                    }
                  }
                ]
              }
            }
          ]
        }
      },
      {
        "name": "build_star",
        "type": "SqlServerStoredProcedure",
        "dependsOn": [
          {
            "activity": "for_each_table",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 2,
          "retryIntervalInSeconds": 60
        },
        "linkedServiceName": {
          "referenceName": "ls_sql",
          "type": "LinkedServiceReference"
        },
        "typeProperties": {
          "storedProcedureName": "dw.usp_load_all",
          "storedProcedureParameters": {
            "pipeline_run_id": {
              "value": {
                "value": "@pipeline().RunId",
                "type": "Expression"
              },
              "type": "String"
            }
          }
        }
      }
    ]
  }
}
